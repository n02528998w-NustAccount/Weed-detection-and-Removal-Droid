<?xml version="1.0"?>
<sdf version="1.9">
  <world name="arena">
    <physics name="default_physics" type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.8 0.9 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.75 0.75 0.7 1</ambient><diffuse>0.75 0.75 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 10 m x 10 m arena walls -->
    <model name="wall_n">
      <static>true</static><pose>0 5.1 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10.4 0.2 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10.4 0.2 0.8</size></box></geometry>
          <material><ambient>0.6 0.3 0.3 1</ambient><diffuse>0.6 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_s">
      <static>true</static><pose>0 -5.1 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10.4 0.2 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10.4 0.2 0.8</size></box></geometry>
          <material><ambient>0.2 0.5 0.6 1</ambient><diffuse>0.2 0.5 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_e">
      <static>true</static><pose>5.1 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 10.4 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 10.4 0.8</size></box></geometry>
          <material><ambient>0.3 0.3 0.7 1</ambient><diffuse>0.3 0.3 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_w">
      <static>true</static><pose>-5.1 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 10.4 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 10.4 0.8</size></box></geometry>
          <material><ambient>0.7 0.6 0.2 1</ambient><diffuse>0.7 0.6 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Things to photograph (kept clear of the patrol lanes at y = -3, -1, 1, 3) -->
    <model name="red_box">
      <static>true</static><pose>0 2 0.25 0 0 0.4</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="orange_box">
      <static>true</static><pose>0 -2 0.25 0 0 -0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.95 0.5 0.1 1</ambient><diffuse>0.95 0.5 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="blue_cylinder">
      <static>true</static><pose>3 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="purple_cylinder">
      <static>true</static><pose>-3 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.6 0.2 0.8 1</ambient><diffuse>0.6 0.2 0.8 1</diffuse></material></visual>
      </link>
    </model>

