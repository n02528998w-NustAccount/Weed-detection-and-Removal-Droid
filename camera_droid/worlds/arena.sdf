          <pose>0 0 0.05 0 0 0</pose>
          <geometry><sphere><radius>0.06</radius></sphere></geometry>
          <material><ambient>0.2 0.8 0.1 1</ambient><diffuse>0.2 0.8 0.1 1</diffuse></material>
