            "units": "slots"
          },
          "label": "START"
        },
        "H1vEoPDpGx": {
          "id": "H1vEoPDpGx",
          "type": "xod/patch-nodes/input-boolean",
          "position": {
            "x": 2,
            "y": 1,
            "units": "slots"
          },
          "label": "BLOCKED"
        },
        "SkESsPwpGe": {
          "id": "SkESsPwpGe",
          "type": "xod/patch-nodes/input-boolean",
          "position": {
            "x": 2,
            "y": 2,
            "units": "slots"
          },
          "label": "CUT"
        },
        "BkyIsvPpGl": {
          "id": "BkyIsvPpGl",
          "type": "xod/patch-nodes/output-number",
          "position": {
            "x": 8,
            "y": 2,
            "units": "slots"
          },
          "label": "STATE"
        }
      },
      "path": "@/droid-state",
      "attachments": [
        {
          "filename": "patch.cpp",
          "encoding": "utf-8",
          "content": "node {\n    uint8_t mode = 0; // 0 IDLE, 1 DRIVE, 2 AVOID, 3 CUT\n\n    void evaluate(Context ctx) {\n        bool blocked = getValue<input_BLOCKED>(ctx);\n        bool cut = getValue<input_CUT>(ctx);\n        bool start = isInputDirty<input_START>(ctx);\n        bool stop = isInputDirty<input_STOP>(ctx);\n\n        uint8_t running = cut ? 3 : 1;\n\n        if (stop) {\n            mode = 0;\n        } else if (mode == 0) {\n            if (start && !blocked) mode = running;\n        } else if (mode == 1) {\n            if (blocked) mode = 2;\n            else if (cut) mode = 3;\n        } else if (mode == 2) {\n            if (!blocked) mode = running;\n        } else if (mode == 3) {\n            if (blocked) mode = 2;\n            else if (!cut) mode = 1;\n        }\n\n        emitValue<output_STATE>(ctx, mode);\n    }\n}"
        }
      ]
    },
