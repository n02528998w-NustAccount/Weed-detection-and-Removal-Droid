      "path": "@/send-state",
      "attachments": [
        {
          "filename": "patch.cpp",
          "encoding": "utf-8",
          "content": "node {\n    bool started = false;\n\n    void evaluate(Context ctx) {\n        if (!started) {\n            Serial.begin(9600);\n            started = true;\n        }\n        if (!isInputDirty<input_SEND>(ctx)) return;\n        Serial.print(\"state:\");\n        Serial.println((int)getValue<input_STATE>(ctx));\n    }\n}"
        }
      ]
    }
