    {
        "id": "507b20b6f28b8699",
        "type": "function",
        "z": "928377b030aa1abc",
        "name": "simulated device",
        "func": "let s = context.get('s') || {mode:0, blocked:false, cut:false};\nswitch (msg.topic) {\n  case 'OBSTACLE': s.blocked = true; break;\n  case 'CLEAR': s.blocked = false; break;\n  case 'CUT_ON': s.cut = true; break;\n  case 'CUT_OFF': s.cut = false; break;\n}\nconst start = msg.topic === 'START';\nconst stop = msg.topic === 'STOP';\nconst running = s.cut ? 3 : 1;\nif (stop) s.mode = 0;\nelse if (s.mode === 0) { if (start && !s.blocked) s.mode = running; }\nelse if (s.mode === 1) { if (s.blocked) s.mode = 2; else if (s.cut) s.mode = 3; }\nelse if (s.mode === 2) { if (!s.blocked) s.mode = running; }\nelse if (s.mode === 3) { if (s.blocked) s.mode = 2; else if (!s.cut) s.mode = 1; }\ncontext.set('s', s);\nreturn { payload: 'state:' + s.mode };",
        "outputs": 1,
        "x": 330,
        "y": 200,
        "wires": [
            [
                "bed1249a661093af"
            ]
        ]
    },
    {
        "id": "bed1249a661093af",
        "type": "function",
        "z": "928377b030aa1abc",
        "name": "parse and log",
        "func": "const m = String(msg.payload).match(/^state:(\\d)$/);\nif (!m) return [null, null];\nconst names = ['IDLE', 'DRIVE', 'AVOID', 'CUT'];\nconst name = names[parseInt(m[1], 10)];\nif (!name) return [null, null];\nconst prev = context.get('prev');\nconst out = [{ payload: name }, null];\nif (name !== prev) {\n  const t = new Date().toLocaleTimeString();\n  let log = context.get('log') || [];\n  log.unshift(t + '  ' + (prev || 'BOOT') + ' -> ' + name);\n  if (log.length > 10) log.pop();\n  context.set('log', log);\n  context.set('prev', name);\n  out[1] = { payload: log };\n}\nreturn out;",
        "outputs": 2,
        "x": 540,
        "y": 200,
        "wires": [
            [
                "b81ac050271ad280"
            ],
            [
                "e7fc1cf792ab2d38",
                "99a541ef486b46e7"
            ]
        ]
