<?xml version="1.0"?>
<sdf version="1.9">
  <model name="weed_cutter">
    <link name="blade_link">
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0002</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="hub">
        <geometry><cylinder><radius>0.02</radius><length>0.015</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
      </visual>
      <visual name="bar_a">
        <geometry><box><size>0.30 0.03 0.004</size></box></geometry>
        <material><ambient>0.7 0 0 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="bar_b">
        <pose>0 0 0 0 0 1.5708</pose>
        <geometry><box><size>0.30 0.03 0.004</size></box></geometry>
        <material><ambient>0.7 0 0 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
      </visual>
      <!-- no collision on purpose: weeds are removed by your area_patrol logic
           (/world/arena/remove), and blade collisions would shove the robot around -->
    </link>
  </model>
</sdf>
