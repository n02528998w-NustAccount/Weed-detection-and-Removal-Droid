<?xml version="1.0"?>
<sdf version="1.9">
  <model name="drive_wheel">
    <link name="wheel_link">
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.00035</ixx><iyy>0.000625</iyy><izz>0.00035</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <!-- cylinder axis is Z by default; roll -90deg so the axle is along Y -->
      <collision name="collision">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="tyre">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <visual name="spoke">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.09 0.032 0.01</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
