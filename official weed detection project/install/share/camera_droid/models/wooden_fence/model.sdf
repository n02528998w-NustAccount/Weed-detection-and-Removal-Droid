<?xml version="1.0"?>
<sdf version="1.9">
  <model name="wooden_fence">
    <static>true</static>
    <link name="link">
      <visual name="fence">
        <geometry><mesh><uri>model://wooden_fence/meshes/fence.obj</uri></mesh></geometry>
        <material>
          <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.04 0.04 0.04 1</specular>
          <pbr><metal>
            <albedo_map>model://wooden_fence/materials/textures/wood.png</albedo_map>
            <roughness>0.85</roughness><metalness>0.0</metalness>
          </metal></pbr>
        </material>
      </visual>
      <collision name="collision"><pose>0 0.02 0.45 0 0 0</pose><geometry><box><size>2.0 0.1 0.9</size></box></geometry></collision>
    </link>
  </model>
</sdf>
